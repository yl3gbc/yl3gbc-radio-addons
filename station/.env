# ============================================================
# Файл настроек станции SONIKS с монитором (.env)
# ============================================================
# Заполните строки под «# ↓ ЗАПОЛНИТЕ»: сразу после =,
# без пробелов и кавычек. Остальные строки не трогайте.
#
# ============================================================
# 1. ЧАСТЬ SONIKS (официальный шаблон клиента, без
#    изменений, добавлены только «ЗАПОЛНИТЕ»)
# ============================================================

# Обязательные переменные
#
# Станция настраивается на портале: страница станции на sonik.space →
# «Настройки станции». Здесь достаточно двух значений оттуда же.

## Параметры станции

# ↓ ЗАПОЛНИТЕ: API-ключ станции с портала sonik.space
STATION__TOKEN=
# ↓ ЗАПОЛНИТЕ: номер станции с портала, только цифры
STATION__ID=

# Координаты и высота берутся с портала (со страницы станции). Задайте здесь,
# только если хотите их переопределить: заданные в .env имеют приоритет.
#STATION__LATITUDE=60.01
#STATION__LONGITUDE=50.05
#STATION__ELEVATION=100


# Прочие переменные
#
# Разделы от «Управления поворотным механизмом» до уровней логирования
# управляются с портала: значения здесь действуют, пока в форме на портале
# ничего не сохранено, и остаются запасными после. Адреса, пути и планировщик
# портал не трогает.

## Параметры URL

URL__BASE=https://sonik.space/api/
URL__JOBS_PATH=jobs/
URL__OBSERVATIONS_PATH=observations/

## Живой канал с порталом
#
# Конфигурация применяется в момент сохранения на портале, а не на следующей
# минуте. Тот же хост и порт 443, закрытым сетям ничего открывать не нужно.
#MQTT__ENABLED=True
#MQTT__URL=wss://sonik.space/mqtt

## Агент обновлений
#
# Читает их сервис soniks-agent (включён в docker-compose.yml), клиент
# их не знает. Умолчания подходят большинству станций; на медленной RPi —
# поднять таймаут gate. Полный список — docs/station/environment_variables.md.
#AGENT__WINDOW_IN_MINUTES=5
#AGENT__GATE_TIMEOUT_IN_SECONDS=60
#AGENT__RETRY_AFTER_HOURS=24

## Обследование приёмника
#
# Станция сама находит подключённые приёмники и по команде с портала
# калибрует усиление. Ручки — порог подъёма шумовой полки и шаг свипа.
#SDR__SCAN_INTERVAL_IN_MINUTES=60
#SDR__IDLE_WINDOW_IN_MINUTES=3
#SDR__GAIN_STEP_DB=2
#SDR__NOISE_LIFT_DB=10

## Управление поворотным механизмом
#
# Штатная схема — сетевой rotctld из compose: MODEL=ROT_MODEL_NETROTCTL и
# PORT=rotctld:4533 (значения по умолчанию, их можно не задавать). Для прямого
# подключения контроллера укажите конкретную модель Hamlib и порт устройства,
# например ROT_MODEL_GS232 и /dev/ttyUSB0. Раскомментируйте PORT, только если
# задаёте своё значение: непустой плейсхолдер проходит валидацию pydantic и
# падает уже внутри Hamlib, где ошибка гораздо менее понятна.

ANTENNA__ROTATOR__ENABLED=False
ANTENNA__ROTATOR__MODEL=ROT_MODEL_NETROTCTL
ANTENNA__ROTATOR__BAUD=9600
#ANTENNA__ROTATOR__PORT=rotctld:4533
ANTENNA__ROTATOR__THRESHOLD=4
ANTENNA__ROTATOR__MODE=Normal
ANTENNA__ROTATOR__MIN_ELEVATION=0

## Управление приемным устройством

ANTENNA__RIG__IP=rigctld
ANTENNA__RIG__PORT=4532

## Параметры наблюдений

OBSERVATION__REMOVE_WATERFALL_RAW_FILES=True
OBSERVATION__REMOVE_OBSERVATION_DATA=True
OBSERVATION__SOAPY_RX_DEVICE=driver=airspy,biastee=true
OBSERVATION__RUN_PRE_OBSERVATION_SCRIPT=True
OBSERVATION__RUN_POST_OBSERVATION_SCRIPT=True

## Параметры flowgraph

FLOWGRAPH__ANTENNA=RX
FLOWGRAPH__RX_SAMP_RATE=3e6
# Усиление — шкала заводского пресета Airspy 0–21 (linearity; для sensitivity
# добавьте gains=sensitivity в строку устройства). LNA=/MIX=/VGA= в
# OTHER_SETTINGS до приёмника не доходят: это не настройки драйвера.
# 14 — замер на станции 46: шум антенны на 20 дБ выше шума приёмника, АЦП
# далеко от насыщения. Уточняйте по sdr_adc_peak (≤ 0.5 без клиппинга).
FLOWGRAPH__GAIN_MODE=Overall
FLOWGRAPH__RF_GAIN=14
# Ниже — переменные, оставленные как напоминание. Они закомментированы, а не
# оставлены строкой без «=»: python-dotenv такую строку пропускает, а парсер
# env_file в Docker Compose понимает её как «унаследовать значение из окружения
# хоста» — то есть поведение станции начинало бы зависеть от того, что
# экспортировано в шелле, откуда запущен compose.
#
# Раскомментируя строку, обязательно подставьте значение: пустое значение
# типизированного поля — это ошибка валидации, а не «значение по умолчанию».

#FLOWGRAPH__ENABLE_IQ_DUMP=False
#FLOWGRAPH__IQ_DUMP_FILENAME=/tmp/.soniks/iq.raw

#FLOWGRAPH__RX_BANDWIDTH=
#FLOWGRAPH__DOPPLER_CORR_PER_SEC=
#FLOWGRAPH__LO_OFFSET=
#FLOWGRAPH__LO_TRANSVERTER=
# Единственная рабочая поправка частоты: freq_corr в строке устройства граф
# затирает этим значением. Готовое число — signal.ppm_error сильного прохода.
#FLOWGRAPH__PPM_ERROR=0
#FLOWGRAPH__RF_GAIN=
#FLOWGRAPH__DEV_ARGS=
#FLOWGRAPH__STREAM_ARGS=
#FLOWGRAPH__TUNE_ARGS=
#FLOWGRAPH__DC_REMOVAL=

## Второй приёмник — другой модели, со своим трактом

# Проход с частотой в RX2__RANGE (МГц) идёт на RX2__DEVICE; незаданные
# RX2__* берутся из FLOWGRAPH__*. Два одинаковых приёмника проще задать
# списком диапазонов в OBSERVATION__SOAPY_RX_DEVICE.
#RX2__DEVICE=driver=rtlsdr,biastee=true
#RX2__RANGE=130-160
#RX2__RX_SAMP_RATE=2.048e6
#RX2__RF_GAIN=25
#RX2__PPM_ERROR=0
#RX2__GAIN_MODE=
#RX2__ANTENNA=
#RX2__RX_BANDWIDTH=
#RX2__OTHER_SETTINGS=
#RX2__DC_REMOVAL=
#RX2__LO_OFFSET=
#FLOWGRAPH__BB_FREQ=

## Уровень логирования всего приложения (кроме планировщика заданий)

LOG__LEVEL=INFO

## Уровень логирования планировщика заданий

SCHEDULER__LOG_LEVEL=WARNING

## Параметры водопада

#WATERFALL__AUTORANGE=True
#WATERFALL__MIN_RANGE_DB=20.0
#WATERFALL__DPI=200
#WATERFALL__HELP_LINES=False

## Декодеры и обвязка прохода (DECODERS__*)
#
# Раздел настроек модели: значения валидируются на старте, опечатка в имени
# или значении — ошибка, а не тихое выключение. До 3.1 те же переключатели
# читались скриптами без префикса (GPIO_ENABLE, ROT_PARK, BANDSCAN_* …) —
# старые имена больше не читаются.

### Парковка ротатора после прохода
# Позиция калибровочная: зависит от того, как физически установлена мачта.

DECODERS__ROT_PARK=False
DECODERS__ROT_PARK_POSITION=180 90

### Реле выбора антенны через MCP2221 по частоте прохода

DECODERS__GPIO_ENABLE=False

### Переименование и сжатие IQ-дампа
# Работают только при FLOWGRAPH__ENABLE_IQ_DUMP.

DECODERS__IQ_DUMP_RENAME=False
DECODERS__IQ_DUMP_COMPRESS=False

### Логи gr_satellites и sstv не удалять после прохода

DECODERS__KEEP_LOGS=False

### Запись полосы по окнам портала (baseband)
# Окно занимает станцию целиком, поэтому включается владельцем. Ширина полосы —
# FLOWGRAPH__RX_SAMP_RATE.
BASEBAND__ENABLE=False
BASEBAND__DIR=/var/lib/soniks-client/baseband

### Сканирование диапазона между проходами
# При BANDSCAN_ENABLE обязательны BANDSCAN_FREQ и BANDSCAN_DEVICE — без них
# этап decoder в метаданных получит error.
# BANDSCAN_DEVICE — селектор устройства для rx_sdr. Отдельно от
# OBSERVATION__SOAPY_RX_DEVICE: там может стоять список «диапазон:устройство»,
# из которого клиент выбирает приёмник по частоте прохода.
# BANDSCAN_SAMPLERATE по умолчанию наследует FLOWGRAPH__RX_SAMP_RATE,
# BANDSCAN_CHANNELS без значения считается по частоте (VHF/UHF/S-band).

DECODERS__BANDSCAN_ENABLE=False
DECODERS__BANDSCAN_FREQ=435e6
DECODERS__BANDSCAN_DEVICE=driver=airspy
DECODERS__BANDSCAN_DIR=/srv/bandscan
#DECODERS__BANDSCAN_SAMPLERATE=3e6
#DECODERS__BANDSCAN_CHANNELS=50

# ============================================================
# 2. ЧАСТЬ SONIKS MONITOR
# ============================================================

# Имя пользователя базы графиков. Можно оставить.
INFLUX_USER=soniks

# ↓ ЗАПОЛНИТЕ: пароль базы графиков, не короче 8 символов
INFLUX_PASSWORD=

# Токен — длинная случайная строка: openssl rand -hex 32
# ↓ ЗАПОЛНИТЕ: токен базы графиков
INFLUX_TOKEN=

# ↓ ЗАПОЛНИТЕ: пароль графиков Grafana (имя: admin)
GRAFANA_PASSWORD=

# Образ монитора. Не меняйте, если не знаете зачем.
MONITOR_IMAGE=docker.io/yl3gbc/soniks-monitor:0.1alfa-amd64
