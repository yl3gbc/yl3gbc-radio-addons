# SONIKS Monitor 0.1alfa — что добавить в .env станции.
#
# .env лежит в папке станции (например ~/soniks-client-new/.env) рядом
# с docker-compose.yml. Ничего из этого файла не копируйте вместе
# с вашими настоящими паролями в публичные места.
#
# --- Уже есть в .env клиента SONIKS (ничего добавлять не нужно) -------
#
# STATION__ID  — номер вашей станции на портале (например 63).
#                Монитор берёт по нему карточку станции, владельца,
#                будущие задания и статистику с портала.
# URL__BASE    — адрес API портала, обычно https://sonik.space/api/
#
# --- Добавить для монитора -------------------------------------------
#
# Пользователь и пароль InfluxDB (база для графиков Grafana).
# Задаются один раз: при первом запуске InfluxDB создаёт с ними
# учётную запись. Пароль — не короче 8 символов.
INFLUX_USER=soniks
INFLUX_PASSWORD=замените-на-свой-пароль
#
# Токен InfluxDB: одна длинная случайная строка. Им пользуются
# InfluxDB, Telegraf и Grafana. Придумайте свой, например так:
#   openssl rand -hex 32
INFLUX_TOKEN=замените-на-свой-токен
#
# Пароль администратора Grafana (вход: admin / этот пароль),
# http://адрес-станции:3000
GRAFANA_PASSWORD=замените-на-свой-пароль
#
# Образ монитора на Docker Hub. Строку можно не добавлять:
# без неё берётся версия 0.1alfa для amd64. Другая версия —
# замените тег после двоеточия и снова запустите up -d.
# Все версии (теги):
#   https://hub.docker.com/r/yl3gbc/soniks-monitor/tags
MONITOR_IMAGE=docker.io/yl3gbc/soniks-monitor:0.1alfa-amd64
